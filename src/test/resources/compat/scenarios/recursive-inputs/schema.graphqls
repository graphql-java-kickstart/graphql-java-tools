directive @limit(range: RangeInput!, unit: LimitUnit = ITEMS, labels: [String!]) on FIELD_DEFINITION | ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

enum LimitUnit {
    ITEMS
    PAGES
}

input RangeInput {
    min: Int!
    max: Int!
}

type Query {
    describe(filter: TreeFilter!): String! @limit(range: {min: 0, max: 5}, labels: ["a", "b"])
    names(first: Int @limit(range: {min: 1, max: 10}, unit: PAGES)): [String!]!
}

input TreeFilter {
    name: String
    and: [TreeFilter!]
    not: TreeFilter
    child: ChildFilter
}

input ChildFilter {
    parent: TreeFilter
    siblings: [[ChildFilter!]!]
    depth: Int! @limit(range: {min: 1, max: 3})
}
