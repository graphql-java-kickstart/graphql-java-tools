schema @tag(name: "schema") @link(url: "https://example.com/v1") @link(url: "https://example.com/v2") {
    query: Query
}

"Tags a node"
directive @tag(
    "The tag's name"
    name: String!
    "How loud"
    level: Int = 1
    kind: Kind = PLAIN
    meta: Meta
) repeatable on OBJECT | INTERFACE | UNION | ENUM | ENUM_VALUE | INPUT_OBJECT | INPUT_FIELD_DEFINITION | FIELD_DEFINITION | ARGUMENT_DEFINITION | SCALAR | SCHEMA

"Marks a node once"
directive @once(
    "Why"
    reason: String = "because"
) on OBJECT | INTERFACE | UNION | ENUM | ENUM_VALUE | INPUT_OBJECT | INPUT_FIELD_DEFINITION | FIELD_DEFINITION | ARGUMENT_DEFINITION | SCALAR

directive @link(url: String!) repeatable on SCHEMA

directive @argDoc(note: String @once @tag(name: "on a directive argument")) on FIELD_DEFINITION

directive @fieldOnly on FIELD_DEFINITION

directive @needs(value: String!) on FIELD_DEFINITION

enum Kind { PLAIN LOUD }

type Query @tag(name: "query") @once @once {
    plain: String
        # described by a comment
        @tag(name: "plain", level: 2)
        @once(reason: "supplied")
        @fieldOnly
        @argDoc(note: "x")
    wrongPlace(arg: String @fieldOnly): String
    missing: String @needs
    old: String @deprecated
    older: String @deprecated(reason: "use plain")
    search(
        filter: Meta @tag(name: "arg", kind: LOUD, meta: {owner: "me"})
        term: String @once @once
    ): String @undeclared(s: "x", i: 1, f: 1.5, b: true, n: null, l: [1, 2], e: []) @undeclared(s: "again") @tag(name: "a") @tag(name: "b")
    animal: Animal
    pet: Pet
    color: Color
    when: Date
    price: Money
}

extend type Query @once(reason: "extension") @tag(name: "extension") @undeclared

interface Animal @tag(name: "animal") @once {
    name: String @once @once
}

type Dog implements Animal {
    name: String
}

union Pet @tag(name: "pet") @once @once = Dog

enum Color @once {
    RED @tag(name: "red") @once @once
    GREEN @deprecated
    BLUE @deprecated(reason: "too blue") @undeclared(why: "blue")
}

input Meta @tag(name: "input") @once {
    owner: String @once(reason: "x") @once
}

"A date"
scalar Date @tag(name: "date") @specifiedBy(url: "https://example.com/date") @once
extend scalar Date @once(reason: "extension") @tag(name: "extension")

scalar Money @tag(nam: "typo")
