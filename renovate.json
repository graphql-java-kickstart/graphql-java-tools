{
  "extends": [
    "github>graphql-java-kickstart/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Group Kotlin updates together",
      "groupName": "kotlin",
      "matchPackageNames": [
        "org.jetbrains.kotlin{/,}**"
      ]
    },
    {
      "description": "Stay on Kotlin 2.3.10, no more upgrades until detekt figures itself out",
      "allowedVersions": "<=2.3.10",
      "matchPackageNames": [
        "org.jetbrains.kotlin:{/,}**"
      ]
    },
    {
      "description": "Align antlr version with graphql-java",
      "allowedVersions": "<=4.11.1",
      "matchPackageNames": [
        "org.antlr{/,}**"
      ]
    },
    {
      "description": "Logback 1.4 requires Java 11",
      "allowedVersions": "!/1\\.4\\..*$/",
      "matchPackageNames": [
        "ch.qos.logback{/,}**"
      ]
    },
    {
      "description": "Spring 6 requires Java 17",
      "allowedVersions": "<6.0.0",
      "matchPackageNames": [
        "/org.springframework/"
      ]
    },
    {
      "description": "Release/snapshot builds use the minimum supported JDK",
      "matchDepNames": [
        "java-jdk"
      ],
      "enabled": false
    }
  ]
}
